{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "paths": {
      "*": ["./src/*"],
      "@core/*": ["./src/core/*"],
      "wrzw": ["./src/core/wrzw/index.ts"],
      "@assets/*": ["./src/assets/*"]
    },
    "resolveJsonModule": true,
    "strict": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
